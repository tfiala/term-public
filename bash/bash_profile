# term-public bash_profile.
#
# Login shells (Ghostty windows, tmux panes via default-shell, SSH)
# read this file; everything lives in bashrc so login and non-login
# interactive shells behave identically.
if [[ -f "$HOME/.bashrc" ]]; then
  source "$HOME/.bashrc"
fi

# Source the user's prior .bash_profile if setup.sh backed it up
# (mirrors the old zshenv.bak pattern).  The guard prevents re-entry
# when the backup itself sources ~/.bash_profile.
if [[ -z "${_TERM_PUBLIC_PROFILE_BAK:-}" && -f "$HOME/.bash_profile.bak" ]]; then
  _TERM_PUBLIC_PROFILE_BAK=1
  source "$HOME/.bash_profile.bak"
fi

# term-public bash_profile.
#
# Login shells (Ghostty windows, tmux panes via default-shell, SSH)
# read this file; everything lives in bashrc so login and non-login
# interactive shells behave identically.

# Stack-scoped re-entry guard, mirroring the one in bashrc: unset on
# every exit path so a later intentional reload still works.
if [[ -n "${_TERM_PUBLIC_PROFILE_ACTIVE:-}" ]]; then
  return 0
fi
_TERM_PUBLIC_PROFILE_ACTIVE=1

if [[ -f "$HOME/.bashrc" ]]; then
  source "$HOME/.bashrc"
fi

# Source the user's prior .bash_profile if setup.sh backed it up
# (mirrors the old zshenv.bak pattern).  A conventional prior profile
# re-sources ~/.bashrc; ours just ran, so hold the bashrc guard for the
# duration to absorb that into a no-op instead of a second full init.
if [[ -f "$HOME/.bash_profile.bak" ]]; then
  _TERM_PUBLIC_BASHRC_ACTIVE=1
  source "$HOME/.bash_profile.bak"
  unset _TERM_PUBLIC_BASHRC_ACTIVE
elif [[ ! -f "$HOME/.bash_login" && -f "$HOME/.profile" ]]; then
  # A login bash reads the first of ~/.bash_profile, ~/.bash_login and
  # ~/.profile.  Linking ~/.bash_profile shadows a ~/.profile that was the
  # account's login file until now (the stock shape on Ubuntu, where it also
  # puts ~/bin and ~/.local/bin on PATH).  Source it under exactly bash's own
  # rule -- only when neither earlier file existed -- and hold the bashrc
  # guard, since the stock ~/.profile re-sources ~/.bashrc.
  _TERM_PUBLIC_BASHRC_ACTIVE=1
  source "$HOME/.profile"
  unset _TERM_PUBLIC_BASHRC_ACTIVE
fi

unset _TERM_PUBLIC_PROFILE_ACTIVE
